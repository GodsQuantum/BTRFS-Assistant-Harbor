<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Btrfs Assistant Harbor — fork of Btrfs Assistant</vendor>
  <vendor_url>https://gitlab.com/btrfs-assistant/btrfs-assistant</vendor_url>
  <action id="org.btrfs-assistant-harbor.pkexec.policy.run">
    <description>Run Btrfs Assistant Harbor</description>
    <message>Authentication is required to administer local Btrfs snapshots and remote backups</message>
    <icon_name>btrfs-assistant-harbor</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/btrfs-assistant-harbor</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="org.btrfs-assistant-harbor.pkexec.policy.stop">
    <description>Stop Harbor manual backup jobs</description>
    <message>Authenticate to stop your Harbor backups</message>
    <icon_name>btrfs-assistant-harbor</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/btrfs-assistant-harbor-tray-stop</annotate>
  </action>
</policyconfig>
